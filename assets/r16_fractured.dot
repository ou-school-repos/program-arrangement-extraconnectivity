graph Fracture_4 {
  graph [label="Fractured 4-Cube (R=16, E=29)", labelloc=t, fontname="Helvetica-bold", fontsize=20];
  node [fontname="Helvetica", style=filled];
    f0 -- f1;
    f0 -- f2;
    f0 -- f4;
    f0 -- f8;
    f1 -- f3;
    f1 -- f5;
    f1 -- f9;
    f2 -- f3;
    f2 -- f6;
    f2 -- f10;
    f3 -- f7;
    f3 -- f11;
    f4 -- f5;
    f4 -- f6;
    f4 -- f12;
    f5 -- f7;
    f5 -- f13;
    f6 -- f7;
    f6 -- f14;
    f8 -- f9;
    f8 -- f10;
    f8 -- f12;
    f9 -- f11;
    f9 -- f13;
    f10 -- f11;
    f10 -- f14;
    f12 -- f13;
    f12 -- f14;
    f15 [fillcolor=orange, label="N15\n(Splintered)"];
    f0 -- f15 [color=red, penwidth=2.0, label=" Rigidity Break"];
}
