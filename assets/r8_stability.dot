graph Comparison_3 {
  graph [label="Stability Analysis (R=8)\nOptimal vs Fractured", labelloc=t, fontname="Helvetica-bold", fontsize=20];
  node [fontname="Helvetica", style=filled, shape=circle, width=0.6];
  edge [penwidth=1.2];
  subgraph cluster_opt {
    label="Optimal 3-Cube (E=12)";
    color=blue; fontcolor=blue; style=dashed;
    o0 [fillcolor=lightblue, label="000"];
    o1 [fillcolor=lightblue, label="001"];
    o2 [fillcolor=lightblue, label="010"];
    o3 [fillcolor=lightblue, label="011"];
    o4 [fillcolor=lightblue, label="100"];
    o5 [fillcolor=lightblue, label="101"];
    o6 [fillcolor=lightblue, label="110"];
    o7 [fillcolor=lightblue, label="111"];
    o0 -- o1;
    o0 -- o2;
    o0 -- o4;
    o1 -- o3;
    o1 -- o5;
    o2 -- o3;
    o2 -- o6;
    o3 -- o7;
    o4 -- o5;
    o4 -- o6;
    o5 -- o7;
    o6 -- o7;
  }
  subgraph cluster_frac {
    label="Fractured 3-Cube (E=10)";
    color=red; fontcolor=red; style=dashed;
    f0 [fillcolor=lightpink, label="000"];
    f1 [fillcolor=lightpink, label="001"];
    f2 [fillcolor=lightpink, label="010"];
    f3 [fillcolor=lightpink, label="011"];
    f4 [fillcolor=lightpink, label="100"];
    f5 [fillcolor=lightpink, label="101"];
    f6 [fillcolor=lightpink, label="110"];
    f0 -- f1;
    f0 -- f2;
    f0 -- f4;
    f1 -- f3;
    f1 -- f5;
    f2 -- f3;
    f2 -- f6;
    f4 -- f5;
    f4 -- f6;
    f7 [fillcolor=orange, label="111
(Splintered)"];
    f0 -- f7 [color=red, penwidth=3.0, label="Rigidity
Break"];
  }
}
