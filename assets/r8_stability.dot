graph Comparison_3 {
  graph [label="Stability Analysis (R=8)
Optimal vs Fractured", labelloc=t, fontname="Helvetica-bold", fontsize=20, rankdir=LR];
  node [fontname="Helvetica", style=filled];
  subgraph cluster_opt {
    label="Optimal 3-Cube (E=12)";
    color=blue; fontcolor=blue; style=dashed;
    node [fillcolor=lightblue];
    o0 -- o1;
    o0 -- o2;
    o0 -- o4;
    o1 -- o3;
    o1 -- o5;
    o2 -- o3;
    o2 -- o6;
    o3 -- o7;
    o4 -- o5;
    o4 -- o6;
    o5 -- o7;
    o6 -- o7;
  }
  subgraph cluster_frac {
    label="Fractured 3-Cube (E=10)";
    color=red; fontcolor=red; style=dashed;
    node [fillcolor=lightpink];
    f0 -- f1;
    f0 -- f2;
    f0 -- f4;
    f1 -- f3;
    f1 -- f5;
    f2 -- f3;
    f2 -- f6;
    f4 -- f5;
    f4 -- f6;
    f7 [fillcolor=orange, label="N7
(Splintered)"];
    f0 -- f7 [color=red, penwidth=2.0];
  }
}
