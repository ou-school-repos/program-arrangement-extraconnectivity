graph Fracture_3 {
  graph [label="Fractured 3-Cube (R=8, E=10)", labelloc=t, fontname="Helvetica-bold", fontsize=20];
  node [fontname="Helvetica", style=filled];
    f0 -- f1;
    f0 -- f2;
    f0 -- f4;
    f1 -- f3;
    f1 -- f5;
    f2 -- f3;
    f2 -- f6;
    f4 -- f5;
    f4 -- f6;
    f7 [fillcolor=orange, label="N7\n(Splintered)"];
    f0 -- f7 [color=red, penwidth=2.0, label=" Rigidity Break"];
}
