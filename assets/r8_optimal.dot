graph Hypercube_3 {
  graph [label="Optimal 3-Cube (R=8, E=12)", labelloc=t, fontname="Helvetica-bold", fontsize=20];
  node [fontname="Helvetica", style=filled, fillcolor=lightblue];
    0 -- 1;
    0 -- 2;
    0 -- 4;
    1 -- 3;
    1 -- 5;
    2 -- 3;
    2 -- 6;
    3 -- 7;
    4 -- 5;
    4 -- 6;
    5 -- 7;
    6 -- 7;
}
