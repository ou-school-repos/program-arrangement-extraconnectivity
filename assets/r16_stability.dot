graph Comparison_4 {
  graph [label="Stability Analysis (R=16)\nOptimal vs Fractured", labelloc=t, fontname="Helvetica-bold", fontsize=20];
  node [fontname="Helvetica", style=filled, shape=circle, width=0.6];
  edge [penwidth=1.2];
  subgraph cluster_opt {
    label="Optimal 4-Cube (E=32)";
    color=blue; fontcolor=blue; style=dashed;
    o0 [fillcolor=lightblue, label="0000"];
    o1 [fillcolor=lightblue, label="0001"];
    o2 [fillcolor=lightblue, label="0010"];
    o3 [fillcolor=lightblue, label="0011"];
    o4 [fillcolor=lightblue, label="0100"];
    o5 [fillcolor=lightblue, label="0101"];
    o6 [fillcolor=lightblue, label="0110"];
    o7 [fillcolor=lightblue, label="0111"];
    o8 [fillcolor=lightblue, label="1000"];
    o9 [fillcolor=lightblue, label="1001"];
    o10 [fillcolor=lightblue, label="1010"];
    o11 [fillcolor=lightblue, label="1011"];
    o12 [fillcolor=lightblue, label="1100"];
    o13 [fillcolor=lightblue, label="1101"];
    o14 [fillcolor=lightblue, label="1110"];
    o15 [fillcolor=lightblue, label="1111"];
    o0 -- o1;
    o0 -- o2;
    o0 -- o4;
    o0 -- o8;
    o1 -- o3;
    o1 -- o5;
    o1 -- o9;
    o2 -- o3;
    o2 -- o6;
    o2 -- o10;
    o3 -- o7;
    o3 -- o11;
    o4 -- o5;
    o4 -- o6;
    o4 -- o12;
    o5 -- o7;
    o5 -- o13;
    o6 -- o7;
    o6 -- o14;
    o7 -- o15;
    o8 -- o9;
    o8 -- o10;
    o8 -- o12;
    o9 -- o11;
    o9 -- o13;
    o10 -- o11;
    o10 -- o14;
    o11 -- o15;
    o12 -- o13;
    o12 -- o14;
    o13 -- o15;
    o14 -- o15;
  }
  subgraph cluster_frac {
    label="Fractured 4-Cube (E=29)";
    color=red; fontcolor=red; style=dashed;
    f0 [fillcolor=lightpink, label="0000"];
    f1 [fillcolor=lightpink, label="0001"];
    f2 [fillcolor=lightpink, label="0010"];
    f3 [fillcolor=lightpink, label="0011"];
    f4 [fillcolor=lightpink, label="0100"];
    f5 [fillcolor=lightpink, label="0101"];
    f6 [fillcolor=lightpink, label="0110"];
    f7 [fillcolor=lightpink, label="0111"];
    f8 [fillcolor=lightpink, label="1000"];
    f9 [fillcolor=lightpink, label="1001"];
    f10 [fillcolor=lightpink, label="1010"];
    f11 [fillcolor=lightpink, label="1011"];
    f12 [fillcolor=lightpink, label="1100"];
    f13 [fillcolor=lightpink, label="1101"];
    f14 [fillcolor=lightpink, label="1110"];
    f0 -- f1;
    f0 -- f2;
    f0 -- f4;
    f0 -- f8;
    f1 -- f3;
    f1 -- f5;
    f1 -- f9;
    f2 -- f3;
    f2 -- f6;
    f2 -- f10;
    f3 -- f7;
    f3 -- f11;
    f4 -- f5;
    f4 -- f6;
    f4 -- f12;
    f5 -- f7;
    f5 -- f13;
    f6 -- f7;
    f6 -- f14;
    f8 -- f9;
    f8 -- f10;
    f8 -- f12;
    f9 -- f11;
    f9 -- f13;
    f10 -- f11;
    f10 -- f14;
    f12 -- f13;
    f12 -- f14;
    f15 [fillcolor=orange, label="1111
(Splintered)"];
    f0 -- f15 [color=red, penwidth=3.0, label="Rigidity
Break"];
  }
}
