# direnv (https://direnv.net) — run `direnv allow` after editing.
watch_file .env
dotenv_if_exists .env

: "${LEAN_CACHE_DIR:=$HOME/.cache/lake}"
export LEAN_CACHE_DIR

# Lake has no env var for relocating .lake (its package clones and build
# output); the actual mechanism is a symlink. Keep proofs/.lake pointed at
# $LEAN_CACHE_DIR so `lake exe cache get` / `make lean[/cache]` never fill up
# the primary disk. Only acts if proofs/.lake doesn't already exist, and
# warns (never overwrites) if it exists and points somewhere else.
_lake_link="proofs/.lake"
_lake_target="$LEAN_CACHE_DIR/program-cheng-connectivity-asymptote-proofs"
if [ ! -e "$_lake_link" ] && [ ! -L "$_lake_link" ]; then
  mkdir -p "$_lake_target"
  ln -s "$_lake_target" "$_lake_link"
elif [ -L "$_lake_link" ] && [ "$(readlink "$_lake_link")" != "$_lake_target" ]; then
  echo "direnv: warning: $_lake_link -> $(readlink "$_lake_link"), not $_lake_target (not touching it)" >&2
fi
unset _lake_link _lake_target
