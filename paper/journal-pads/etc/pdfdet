#!/bin/bash -e

cleanup() {
  [[ -n "${tmp:-}" && -e "$tmp" ]] && rm -f -- "$tmp"
}
trap cleanup EXIT

for pdf in "$@"; do
  timestamp="$(stat -c "%Y" "$pdf")"
  pdf_date="$(date -u -d "@$timestamp" '+%Y:%m:%d %H:%M:%S+00:00')"
  tmp="$(mktemp --tmpdir="$(dirname "$pdf")" ".$(basename "$pdf").XXXXXX")"

  qpdf --deterministic-id "$pdf" "$tmp"

  exiftool -overwrite_original \
    -CreateDate="$pdf_date" \
    -ModifyDate="$pdf_date" \
    "$tmp" >/dev/null

  mv -f "$tmp" "$pdf"
  touch -d "@$timestamp" "$pdf"
  tmp=""
done
