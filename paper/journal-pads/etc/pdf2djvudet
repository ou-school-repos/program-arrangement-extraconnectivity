#!/bin/bash
#
# Shane Jaroch (2025)
# git config --global diff.djvu.textconv "djvused -e 'print-meta; print-xmp'"
# Make sure .gitattributes contains:
#   *.djvu diff=djvu

set -e

for f in "$@"; do
    echo "Processing: $f"
    OUT="${f%.pdf}.djvu"

    # 1. Capture the TRUE modification time from the source PDF
    # (Requires 'pdfinfo' from poppler-utils)
    # We clean it to a simple string to avoid format headaches
    PDF_MOD_DATE=$(pdfinfo -isodates "$f" | grep "ModDate" | cut -d: -f2- | sed 's/ //g')

    # 2. Build the DjVu
    pdf2djvu "$f" -o "$OUT"

    # 3. SANITIZE XMP (The "Kill List")
    # We kill the volatile XMP data as before
    djvused "$OUT" -e 'print-xmp' | \
        sed -E '/xmp:MetadataDate|xmpMM:DocumentID|xmpMM:InstanceID|stEvt:instanceID|stEvt:when|xmp:CreatorTool/d' > temp_clean.xmp

    djvused "$OUT" -e 'set-xmp temp_clean.xmp' -s

    # 4. INJECT THE CANARY (Standard Metadata)
    # We pull the existing metadata, and force our PDF_MOD_DATE into a "source_mod" field.
    # This ensures that if the PDF changes, this line changes.
    djvused "$OUT" -e 'select 1; print-meta' | \
        grep -v '(source_mod' | \
        sed "s/)$/ (source_mod \"$PDF_MOD_DATE\"))/" > temp_meta.txt

    djvused "$OUT" -e 'set-meta temp_meta.txt' -s

    # 5. SYNC FILESYSTEM MODIFIED DATE
    # This makes the .djvu match the .pdf on the disk level
    touch -r "$f" "$OUT"

    # Cleanup
    rm -f temp_clean.xmp temp_meta.txt
done
