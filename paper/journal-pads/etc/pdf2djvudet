#!/bin/bash
#
# Shane Jaroch (2025)
# git config --global diff.djvu.textconv "djvused -e 'print-meta; print-xmp'"
# Make sure .gitattributes contains:
#   *.djvu diff=djvu

set -e
set -o pipefail

for f in "$@"; do
    echo "Processing: $f"
    OUT="${f%.pdf}.djvu"

    # Private per-invocation scratch dir: avoids collisions between
    # concurrent invocations (or interrupted runs) sharing fixed filenames
    # in the current directory.
    TMPDIR_PDD="$(mktemp -d)"
    trap 'rm -rf -- "$TMPDIR_PDD"' EXIT
    TEMP_XMP="$TMPDIR_PDD/temp_clean.xmp"
    TEMP_META="$TMPDIR_PDD/temp_meta.txt"

    # 1. Capture the TRUE modification time from the source PDF
    # (Requires 'pdfinfo' from poppler-utils)
    # We clean it to a simple string to avoid format headaches
    PDF_MOD_DATE=$(pdfinfo -isodates "$f" | grep "ModDate" | cut -d: -f2- | sed 's/ //g')

    # 2. Build the DjVu
    pdf2djvu "$f" -o "$OUT"

    # 3. SANITIZE XMP (The "Kill List")
    # We kill the volatile XMP data as before
    TEMP_XMP_RAW="$TMPDIR_PDD/temp_xmp_raw.txt"
    djvused "$OUT" -e 'print-xmp' > "$TEMP_XMP_RAW"
    sed -E '/xmp:MetadataDate|xmpMM:DocumentID|xmpMM:InstanceID|stEvt:instanceID|stEvt:when|xmp:CreatorTool/d' "$TEMP_XMP_RAW" > "$TEMP_XMP"

    djvused "$OUT" -e "set-xmp \"$TEMP_XMP\"" -s

    # 4. INJECT THE CANARY (Standard Metadata)
    # We pull the existing metadata, and force our PDF_MOD_DATE into a "source_mod" field.
    # This ensures that if the PDF changes, this line changes.
    TEMP_META_RAW="$TMPDIR_PDD/temp_meta_raw.txt"
    djvused "$OUT" -e 'select 1; print-meta' > "$TEMP_META_RAW"
    # grep -v exits 1 (with pipefail) when every line matched the filter
    # (i.e. nothing was removed) -- an expected outcome, not a failure.
    if grep -v $'^source_mod\t' "$TEMP_META_RAW" > "$TEMP_META"; then
        :
    else
        rc=$?
        if (( rc != 1 )); then
            exit "$rc"
        fi
    fi
    printf 'source_mod\t"%s"\n' "$PDF_MOD_DATE" >> "$TEMP_META"

    djvused "$OUT" -e "set-meta \"$TEMP_META\"" -s

    # 5. SYNC FILESYSTEM MODIFIED DATE
    # This makes the .djvu match the .pdf on the disk level
    touch -r "$f" "$OUT"

    # Cleanup
    rm -rf -- "$TMPDIR_PDD"
    trap - EXIT
done
